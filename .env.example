# Local development: file-based SQLite (fallback when Turso vars are not set)
DATABASE_URL=file:./db/custom.db

# Turso (libSQL) — production database (required for Vercel deployment)
# Create at https://app.turso.tech → Database → Connect
TURSO_DATABASE_URL=libsql://your-db-your-org.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
